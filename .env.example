# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Public URL of the site (no trailing slash).
# Local: http://localhost:3000   Production: https://royal-poker.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (needed from Stage 2) ---------------------------------------
# Supabase dashboard -> Project Settings -> API
# These two are safe to expose to the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server only. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never use in client components.
SUPABASE_SERVICE_ROLE_KEY=
