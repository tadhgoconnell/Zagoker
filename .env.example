# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Public URL of the site (no trailing slash).
# Local: http://localhost:3000   Production: https://royal-poker.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (needed from Stage 2) ---------------------------------------
# Supabase dashboard -> Project Settings -> API
# These two are safe to expose to the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Game server key (needed from Stage 4) ----------------------------------
# SECRET. Server only. Never prefix with NEXT_PUBLIC_.
# Proves to the database that a request comes from the game server. Generate
# one and register its hash with:  node scripts/generate-game-key.mjs
GAME_SERVER_KEY=
